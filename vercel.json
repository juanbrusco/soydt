{
  "version": 2,
  "buildCommand": "vite build && esbuild server-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
